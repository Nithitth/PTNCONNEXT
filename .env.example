# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect").
# .env.local is ignored by Git — never commit real keys.

# Safe for the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET — server only. Skips all security rules. Never share or put in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# SECRET — lets Vercel Cron run the daily clean-up of expired PDFs (/api/cron/expire-files).
# Any long random text (at least 16 characters). Add the same value in Vercel → Environment Variables.
CRON_SECRET=make-up-a-long-random-text

# SECRET — signs the sign-up steps and scrambles sign-up codes. Any long random text (at least 16
# characters). Use a different value in Vercel. Changing it later makes unused personal codes stop working.
SIGNUP_SECRET=make-up-another-long-random-text

# SECRET — scrambles the hidden log-in emails so nobody can sign in to Supabase directly (skipping our
# lockout). Any long random text (at least 16 characters), different in the test project and in Vercel.
# If you ever change it, run: npm run migrate:auth-emails -- --apply   (or nobody can log in).
LOGIN_EMAIL_SECRET=make-up-a-third-long-random-text

# Google Drive for teachers' PDFs (optional; docs/SETUP.md, "Google Drive"). Without these three, the
# Drive option doesn't show and PDFs are kept in Connext as before.
# Client ID and secret come from Google Cloud → APIs & Services → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SECRET — encrypts teachers' Google keys in the database. Any long random text (at least 16 characters),
# different in the test project and in Vercel. Changing it disconnects every teacher (they connect again).
GOOGLE_TOKEN_SECRET=

# Email codes for sign-up are sent from a school Gmail account (see docs/SETUP.md, step "Email").
# SMTP_PASS is a Gmail *app password* (16 letters), not the normal password.
SMTP_USER=school-account@gmail.com
SMTP_PASS=your-16-letter-app-password
