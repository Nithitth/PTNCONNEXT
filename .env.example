# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API (or "Connect").
# .env.local is ignored by Git — never commit real keys.

# Safe for the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET — server only. Skips all security rules. Never share or put in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# SECRET — lets Vercel Cron run the daily clean-up of expired PDFs (/api/cron/expire-files).
# Any long random text (at least 16 characters). Add the same value in Vercel → Environment Variables.
CRON_SECRET=make-up-a-long-random-text
